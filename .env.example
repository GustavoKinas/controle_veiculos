# Modelo sem credenciais. Copie para .env e preencha os valores da infraestrutura.
# O servidor WSGI não inicia enquanto a configuração obrigatória do AD estiver vazia.
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
DJANGO_PORTARIA_PASSWORD=
CLIENT_ID=
TENANT_ID=
SECRETY_VALUE=
URL_MICROSOFT=
ERP_FUNCIONARIOS_API_URL=
ERP_FUNCIONARIOS_API_TOKEN=
ERP_FUNCIONARIOS_API_TIMEOUT=

# AD on-premises: preencha os campos vazios com valores fornecidos pela TI.
LDAP_URI=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_TLS_PROFILE=validated
LDAP_CA_CERT_FILE=/run/certs/flexivel-root-ca.crt
LDAP_NETWORK_TIMEOUT=5
LDAP_OPERATION_TIMEOUT=10
SESSION_MAX_AGE=28800
AD_DNS_PRIMARY=
AD_DNS_SEARCH=
